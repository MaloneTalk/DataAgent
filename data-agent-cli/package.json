{
  "name": "@malone-talk/data-agent-cli",
  "version": "1.0.0",
  "description": "CLI for calling DataAgent agent tools over REST with a personal access token.",
  "type": "module",
  "bin": {
    "data-agent-cli": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
